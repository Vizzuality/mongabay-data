# Copy to .env and fill in. `.env` is gitignored; never commit real values.
# Loaded with `python-dotenv`:
#
#     from dotenv import load_dotenv
#     load_dotenv()

# Path to the Google service account key used by Earth Engine and GCS.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Cloud project the service account belongs to.
GOOGLE_CLOUD_PROJECT=
